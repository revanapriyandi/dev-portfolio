# Analytics (public, safe to expose)
NEXT_PUBLIC_GTM=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Clerk (admin dashboard login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_
CLERK_SECRET_KEY=sk_
# Comma-separated Clerk user IDs allowed into /dashboard (user_xxx). Empty = nobody.
ADMIN_USER_IDS=

# Admin database (Supabase): inbox, chat logs, page views. Server-only — never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Aksa, the AI assistant (server-only, never prefix with NEXT_PUBLIC_)
GROQ_API_KEY=

# Contact form delivery: Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Contact form delivery: Gmail app password
EMAIL_ADDRESS=
GMAIL_PASSKEY=
